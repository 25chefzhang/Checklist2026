/* pages/summary/summary.wxss — 工作总结页样式 */

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* === 统计卡片三栏 === */
.stats-row {
  display: flex;
  margin: 20rpx 24rpx;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  padding: 24rpx 16rpx;
  text-align: center;
}

.stat-success {
  border-top: 6rpx solid var(--color-success);
}

.stat-pending {
  border-top: 6rpx solid var(--color-warning);
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.2;
}

.stat-success .stat-num {
  color: var(--color-success);
}

.stat-pending .stat-num {
  color: var(--color-warning);
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* === 通用卡片 === */
.card {
  margin: 20rpx 24rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  padding: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.section-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 400;
}

/* === 来源分布条 === */
.source-bars {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.source-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.source-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  width: 100rpx;
  flex-shrink: 0;
}

.source-bar-wrap {
  flex: 1;
  height: 18rpx;
  border-radius: 9rpx;
  background: var(--color-border);
  overflow: hidden;
}

.source-bar-fill {
  height: 100%;
  border-radius: 9rpx;
  background: var(--color-primary);
  transition: width 0.5s ease;
  min-width: 4rpx;
}

.source-bar-fill.clipboard {
  background: #e65100;
}

.source-bar-fill.manual {
  background: #7b1fa2;
}

.source-count {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
  width: 48rpx;
  text-align: right;
  flex-shrink: 0;
}

/* === 优先级分布 === */
.priority-dots {
  display: flex;
  justify-content: space-around;
  padding: 8rpx 0;
}

.priority-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.dot-high {
  background: var(--color-danger);
}

.dot-medium {
  background: var(--color-warning);
}

.dot-low {
  background: var(--color-success);
}

/* === 月度趋势条 === */
.monthly-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.monthly-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.month-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  width: 130rpx;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.monthly-bar-wrap {
  flex: 1;
  height: 22rpx;
  border-radius: 11rpx;
  background: #e8eaed;
  overflow: hidden;
}

.monthly-bar-fill {
  height: 100%;
  border-radius: 11rpx;
  background: var(--color-primary);
  transition: width 0.5s ease;
  min-width: 4rpx;
}

.monthly-fraction {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
  width: 80rpx;
  text-align: right;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

/* === 文本总结 === */
.summary-text-card {
  background: #f8f9fa;
  border: 1rpx solid var(--color-border);
}

.summary-text {
  font-family: 'SF Mono', 'Menlo', 'Courier New', monospace;
  font-size: 24rpx;
  color: var(--color-text);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

/* === 最近完成任务列表 === */
.mini-task-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mini-task {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.mini-task:last-child {
  border-bottom: none;
}

.mini-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e8f5e9;
  color: var(--color-success);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mini-content {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-date {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

/* === 空状态 === */
.empty-hint {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  padding: 30rpx 0;
}

/* === 底部间距 === */
.bottom-spacer {
  height: 40rpx;
}
