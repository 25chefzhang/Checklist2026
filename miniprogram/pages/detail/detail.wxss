/* pages/detail/detail.wxss — 任务详情页样式 */

.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* === 优先级色条 === */
.priority-bar {
  height: 8rpx;
  width: 100%;
}

.priority-bar.priority-high {
  background: var(--color-danger);
}

.priority-bar.priority-medium {
  background: var(--color-warning);
}

.priority-bar.priority-low {
  background: var(--color-success);
}

/* === 卡片通用 === */
.card {
  margin: 20rpx 24rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  padding: 28rpx;
}

/* === 内容卡片 === */
.content-card {
  margin-top: 28rpx;
}

.task-content {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.6;
  word-break: break-all;
  margin-bottom: 20rpx;
}

/* === 标签行 === */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  line-height: 1.4;
}

.source-tag {
  background: #e8f5e9;
  color: #2e7d32;
}

.source-tag.source-voice {
  background: #e3f2fd;
  color: #1565c0;
}

.source-tag.source-clipboard {
  background: #fff3e0;
  color: #e65100;
}

.source-tag.source-manual {
  background: #f3e5f5;
  color: #7b1fa2;
}

.priority-tag {
  font-weight: 500;
}

.priority-tag.priority-high {
  background: #fdecea;
  color: var(--color-danger);
}

.priority-tag.priority-medium {
  background: #fff8e1;
  color: #e65100;
}

.priority-tag.priority-low {
  background: #e8f5e9;
  color: var(--color-success);
}

.status-done-tag {
  background: #e8f5e9;
  color: var(--color-success);
}

.status-pending-tag {
  background: #fff3e0;
  color: var(--color-warning);
}

/* === 信息卡片 === */
.info-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  margin-right: 20rpx;
  min-width: 120rpx;
}

.info-value {
  font-size: 26rpx;
  color: var(--color-text);
  text-align: right;
  word-break: break-all;
  flex: 1;
}

.date-relative {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.date-absolute {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
}

.mini-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #ecf0f1;
  color: var(--color-text-secondary);
}

.notes-text {
  font-style: italic;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.completed-time {
  color: var(--color-success);
  font-weight: 500;
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 10rpx 0;
}

/* === 操作按钮 === */
.action-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-toggle {
  background: var(--color-primary);
  color: #fff;
}

.btn-delete {
  background: #fdecea;
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger);
}

/* === 空状态 === */
.empty-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
