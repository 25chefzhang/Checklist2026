<view class="dialog-container" wx:if="{{visible}}">
  <!-- 遮罩层 -->
  <view class="mask" bindtap="onMaskTap" catchtouchmove="noop"></view>

  <!-- 弹窗卡片 -->
  <view class="dialog-card" catchtap="noop">
    <!-- 标题 -->
    <view class="dialog-title">{{title}}</view>

    <!-- 内容 -->
    <view class="dialog-content" wx:if="{{content}}">{{content}}</view>

    <!-- 按钮区 -->
    <view class="dialog-actions">
      <view
        wx:if="{{showCancel}}"
        class="dialog-btn cancel-btn"
        bindtap="onCancel"
      >{{cancelText}}</view>
      <view
        class="dialog-btn confirm-btn {{showCancel ? '' : 'full-width'}}"
        bindtap="onConfirm"
      >{{confirmText}}</view>
    </view>
  </view>
</view>
