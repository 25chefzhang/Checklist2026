.float-button-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 999;
}

/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  pointer-events: auto;
  z-index: 997;
  animation: fadeIn 0.2s ease;
}

/* 菜单项容器 */
.menu-items {
  position: fixed;
  pointer-events: auto;
  z-index: 998;
  display: flex;
  flex-direction: column-reverse;
  gap: 16rpx;
  padding-bottom: 120rpx;
}

/* 菜单项 */
.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.12);
  animation: menuIn 0.3s ease both;
}

.menu-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.menu-label {
  font-size: 22rpx;
  color: #333;
  white-space: nowrap;
}

/* 主按钮 */
.main-btn {
  position: fixed;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(26, 115, 232, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 24rpx rgba(26, 115, 232, 0.4);
  pointer-events: auto;
  z-index: 999;
  transition: transform 0.25s ease, background 0.25s ease;
}

.main-btn.expanded {
  transform: rotate(135deg);
  background: rgba(26, 115, 232, 0.95);
}

.btn-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  transition: transform 0.25s ease;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes menuIn {
  from {
    opacity: 0;
    transform: scale(0.3) translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}
