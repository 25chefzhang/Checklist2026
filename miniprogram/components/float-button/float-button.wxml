<view class="float-button-container" wx:if="{{visible}}">
  <!-- 展开时的遮罩层 -->
  <view class="mask" wx:if="{{expanded}}" bindtap="collapse" catchtouchmove="noop"></view>

  <!-- 菜单项列表 -->
  <view class="menu-items" wx:if="{{expanded}}" style="left: {{x}}px; bottom: {{menuBottom}}px;">
    <view
      class="menu-item"
      wx:for="{{menus}}"
      wx:key="key"
      data-index="{{index}}"
      bindtap="onMenuItemTap"
      style="animation-delay: {{item.delay}}s;"
    >
      <view class="menu-icon">{{item.icon}}</view>
      <view class="menu-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 主按钮 -->
  <view
    class="main-btn {{expanded ? 'expanded' : ''}}"
    style="left: {{x}}px; top: {{y}}px;"
    bindtap="toggleExpand"
    catchtouchmove="onTouchMove"
  >
    <text class="btn-icon">{{expanded ? '✕' : '＋'}}</text>
  </view>
</view>
